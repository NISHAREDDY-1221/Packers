generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------
// Auth & RBAC
// ----------------------------------------
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workOrders     WorkOrder[]
  assignedWos    WorkOrder[] @relation("OperatorAssigned")
  assignedQc     WorkOrder[] @relation("InspectorAssigned")
  qualityChecks  QualityCheck[]
  materialIssues MaterialIssue[]
  auditLogs      AuditLog[]
  reportedIssues Issue[] @relation("ReportedIssues")

  requestedApprovals ApprovalRequest[] @relation("RequestedApprovals")
  approvalActions    ApprovalHistory[] @relation("ApprovalActions")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // ADMIN, MANAGER, OPERATOR, QC_INSPECTOR
  description String?
  permissions String[] // JSON or String Array of permission keys
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ----------------------------------------
// Master Data
// ----------------------------------------
model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model UnitOfMeasure {
  id           String    @id @default(uuid())
  name         String    @unique // e.g. kg, g, ml, L, pcs
  abbreviation String    @unique
  isActive     Boolean   @default(true)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id            String         @id @default(uuid())
  sku           String         @unique
  name          String
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  uomId         String
  uom           UnitOfMeasure  @relation(fields: [uomId], references: [id])
  type          ProductType // RAW_MATERIAL, PACKAGING, FINISHED_GOOD
  isActive      Boolean        @default(true)
  availableStock Float?        @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  recipesAsOutput Recipe[]       @relation("RecipeOutput")
  recipeItems     RecipeItem[]
  workOrders      WorkOrder[]
  finishedGoods   FinishedGoods[]
}

enum ProductType {
  RAW_MATERIAL
  PACKAGING
  FINISHED_GOOD
}

model Warehouse {
  id               String            @id @default(uuid())
  name             String            @unique
  location         String?
  isActive         Boolean           @default(true)
  storageLocations StorageLocation[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model StorageLocation {
  id          String    @id @default(uuid())
  name        String // e.g. Rack A1, Bin 2
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ----------------------------------------
// Recipe (BOM)
// ----------------------------------------
model Recipe {
  id              String       @id @default(uuid())
  code            String       @unique
  name            String
  outputProductId String
  outputProduct   Product      @relation("RecipeOutput", fields: [outputProductId], references: [id])
  outputQty       Float
  items           RecipeItem[]
  workOrders      WorkOrder[]
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model RecipeItem {
  id              String   @id @default(uuid())
  recipeId        String
  recipe          Recipe   @relation(fields: [recipeId], references: [id])
  inputProductId  String
  inputProduct    Product  @relation(fields: [inputProductId], references: [id])
  requiredQty     Float
  tolerancePct    Float    @default(0) // Acceptable deviation %
  isPackaging     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ----------------------------------------
// Workflow: Packing & Execution
// ----------------------------------------
model WorkOrder {
  id               String      @id @default(uuid())
  woNumber         String      @unique
  productId        String
  product          Product     @relation(fields: [productId], references: [id])
  recipeId         String
  recipe           Recipe      @relation(fields: [recipeId], references: [id])
  status           WoStatus    @default(DRAFT)
  priority         WoPriority  @default(MEDIUM)
  requiredQty      Float
  actualProduced   Float?
  actualRejected   Float?
  batchNumber      String?     @unique
  supervisorId     String
  supervisor       User        @relation(fields: [supervisorId], references: [id])
  
  isPaused         Boolean     @default(false)
  pauseReason      String?
  
  operatorId       String?
  operator         User?       @relation("OperatorAssigned", fields: [operatorId], references: [id])

  inspectorId      String?
  inspector        User?       @relation("InspectorAssigned", fields: [inspectorId], references: [id])
  
  expectedDate     DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  materialIssues   MaterialIssue[]
  qualityChecks    QualityCheck[]
  finishedGoods    FinishedGoods[]
  repackingLogs    RepackingLog[]
  reportedIssues   Issue[]
}

enum WoStatus {
  DRAFT
  PENDING
  APPROVED
  MATERIAL_ISSUED
  PACKING_STARTED
  QC_PENDING
  QC_PASSED
  COMPLETED
  CANCELLED
}

enum WoPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model MaterialIssue {
  id         String   @id @default(uuid())
  issueNo    String   @unique
  woId       String
  workOrder  WorkOrder @relation(fields: [woId], references: [id])
  issuedById String
  issuedBy   User      @relation(fields: [issuedById], references: [id])
  status     IssueStatus @default(PENDING)
  payload    Json     // Specific items and qtys issued (snapshot)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum IssueStatus {
  PENDING
  ISSUED
}

// ----------------------------------------
// Workflow: QC & Finished Goods
// ----------------------------------------
model QualityCheck {
  id            String   @id @default(uuid())
  qcNumber      String   @unique
  woId          String
  workOrder     WorkOrder @relation(fields: [woId], references: [id])
  inspectorId   String
  inspector     User      @relation(fields: [inspectorId], references: [id])
  checkedQty    Float
  result        QcResult
  severity      QcSeverity?
  failureReason String?
  remarks       String?
  checksPayload Json      // Specific checklist booleans
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum QcResult {
  PASS
  PARTIAL_PASS
  REJECT
  REWORK
  DISCARD
}

enum QcSeverity {
  MINOR
  MAJOR
  CRITICAL
}

model FinishedGoods {
  id             String   @id @default(uuid())
  fgNumber       String   @unique
  woId           String
  workOrder      WorkOrder @relation(fields: [woId], references: [id])
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  batchNumber    String
  postedQty      Float
  destination    String    // Warehouse, Store, etc.
  costPayload    Json?     // Stored costing breakdown
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ----------------------------------------
// Workflow: Repacking
// ----------------------------------------
model RepackingLog {
  id                  String   @id @default(uuid())
  rpNumber            String   @unique
  sourceWoId          String
  sourceWorkOrder     WorkOrder @relation(fields: [sourceWoId], references: [id])
  repackType          String
  recoverableQty      Float
  wasteQty            Float
  newBatchNumber      String?
  targetRecipeId      String?  // If re-routed to a different BOM
  loggedById          String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ----------------------------------------
// Audit Logs
// ----------------------------------------
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // e.g. UPDATE_WO_STATUS
  entity     String   // e.g. WorkOrder
  entityId   String
  oldData    Json?
  newData    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

// ----------------------------------------
// Approvals
// ----------------------------------------

enum ApprovalType {
  WORK_ORDER
  MATERIAL_ISSUE
  PACKING_VARIANCE
  QC_REWORK
  REPACKING
  BARCODE_REPRINT
  FINISHED_GOODS
  WASTAGE_SCRAP
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ApprovalRequest {
  id                String            @id @default(uuid())
  type              ApprovalType
  relatedEntityId   String
  relatedEntityName String
  requestedById     String
  requestedBy       User              @relation("RequestedApprovals", fields: [requestedById], references: [id])
  requestedDate     DateTime          @default(now())
  reason            String
  priority          Priority
  status            ApprovalStatus    @default(PENDING)
  existingValues    Json?
  proposedValues    Json?
  remarks           String?
  attachments       String[]
  history           ApprovalHistory[]
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model ApprovalHistory {
  id                String          @id @default(uuid())
  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  action            String
  actionById        String
  actionBy          User            @relation("ApprovalActions", fields: [actionById], references: [id])
  actionDate        DateTime        @default(now())
  comments          String?
}

// ----------------------------------------
// Issues
// ----------------------------------------

model Issue {
  id           String    @id @default(uuid())
  type         IssueType
  description  String
  photoUrls    String[]  @default([])
  woId         String?
  workOrder    WorkOrder? @relation(fields: [woId], references: [id])
  reportedById String
  reportedBy   User       @relation("ReportedIssues", fields: [reportedById], references: [id])
  status       String     @default("OPEN")
  priority     Priority   @default(MEDIUM)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum IssueType {
  MACHINE_ISSUE
  MATERIAL_SHORTAGE
  BARCODE_PROBLEM
  DAMAGED_PRODUCT
  PACKING_QUALITY_ISSUE
  APP_SYSTEM_ISSUE
  OTHER
}

