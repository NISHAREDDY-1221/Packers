generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String            @id @default(uuid())
  email              String            @unique
  password           String
  name               String
  roleId             String
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  approvalActions    ApprovalHistory[] @relation("ApprovalActions")
  requestedApprovals ApprovalRequest[] @relation("RequestedApprovals")
  auditLogs          AuditLog[]
  reportedIssues     Issue[]           @relation("ReportedIssues")
  LabelPrintJob      LabelPrintJob[]
  materialIssues     MaterialIssue[]
  qualityChecks      QualityCheck[]
  role               Role              @relation(fields: [roleId], references: [id])
  assignedQc         WorkOrder[]       @relation("InspectorAssigned")
  assignedWos        WorkOrder[]       @relation("OperatorAssigned")
  workOrders         WorkOrder[]

  assignedTasks      LabelApplicationTask[] @relation("AssignedTasks")
  tasksAssignedBy    LabelApplicationTask[] @relation("TasksAssignedBy")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isActive    Boolean   @default(true)
  products    Product[]
}

model UnitOfMeasure {
  id           String    @id @default(uuid())
  name         String    @unique
  abbreviation String    @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  isActive     Boolean   @default(true)
  products     Product[]
}

model Product {
  id              String          @id @default(uuid())
  sku             String          @unique
  name            String
  categoryId      String
  uomId           String
  type            ProductType
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  availableStock  Float?          @default(0)
  finishedGoods   FinishedGoods[]
  category        Category        @relation(fields: [categoryId], references: [id])
  uom             UnitOfMeasure   @relation(fields: [uomId], references: [id])
  recipesAsOutput Recipe[]        @relation("RecipeOutput")
  recipeItems     RecipeItem[]
  workOrders      WorkOrder[]
}

model Warehouse {
  id               String            @id @default(uuid())
  name             String            @unique
  location         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isActive         Boolean           @default(true)
  storageLocations StorageLocation[]
}

model StorageLocation {
  id          String    @id @default(uuid())
  name        String
  warehouseId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
}

model Recipe {
  id              String       @id @default(uuid())
  code            String       @unique
  name            String
  outputProductId String
  outputQty       Float
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  outputProduct   Product      @relation("RecipeOutput", fields: [outputProductId], references: [id])
  items           RecipeItem[]
  workOrders      WorkOrder[]
}

model RecipeItem {
  id             String   @id @default(uuid())
  recipeId       String
  inputProductId String
  requiredQty    Float
  tolerancePct   Float    @default(0)
  isPackaging    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  inputProduct   Product  @relation(fields: [inputProductId], references: [id])
  recipe         Recipe   @relation(fields: [recipeId], references: [id])
}

model WorkOrder {
  id             String          @id @default(uuid())
  woNumber       String          @unique
  productId      String
  recipeId       String
  status         WoStatus        @default(DRAFT)
  priority       WoPriority      @default(MEDIUM)
  requiredQty    Float
  actualProduced Float?
  actualRejected Float?
  batchNumber    String?         @unique
  supervisorId   String
  expectedDate   DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inspectorId    String?
  isPaused       Boolean         @default(false)
  operatorId     String?
  pauseReason    String?
  labelsPrinted  Float           @default(0)
  labelsApplied  Float           @default(0)
  finishedGoods  FinishedGoods[]
  reportedIssues Issue[]
  LabelPrintJob  LabelPrintJob[]
  materialIssues MaterialIssue[]
  qualityChecks  QualityCheck[]
  repackingLogs  RepackingLog[]
  inspector      User?           @relation("InspectorAssigned", fields: [inspectorId], references: [id])
  operator       User?           @relation("OperatorAssigned", fields: [operatorId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  recipe         Recipe          @relation(fields: [recipeId], references: [id])
  supervisor     User            @relation(fields: [supervisorId], references: [id])
  labelTasks     LabelApplicationTask[]
}

model MaterialIssue {
  id         String      @id @default(uuid())
  issueNo    String      @unique
  woId       String
  issuedById String
  status     IssueStatus @default(PENDING)
  payload    Json
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  issuedBy   User        @relation(fields: [issuedById], references: [id])
  workOrder  WorkOrder   @relation(fields: [woId], references: [id])
}

model QualityCheck {
  id            String      @id @default(uuid())
  qcNumber      String      @unique
  woId          String
  inspectorId   String
  checkedQty    Float
  result        QcResult
  severity      QcSeverity?
  failureReason String?
  remarks       String?
  checksPayload Json
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  inspector     User        @relation(fields: [inspectorId], references: [id])
  workOrder     WorkOrder   @relation(fields: [woId], references: [id])
}

model FinishedGoods {
  id          String    @id @default(uuid())
  fgNumber    String    @unique
  woId        String
  productId   String
  batchNumber String
  postedQty   Float
  destination String
  costPayload Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id])
  workOrder   WorkOrder @relation(fields: [woId], references: [id])
}

model RepackingLog {
  id              String    @id @default(uuid())
  rpNumber        String    @unique
  sourceWoId      String
  repackType      String
  recoverableQty  Float
  wasteQty        Float
  newBatchNumber  String?
  targetRecipeId  String?
  loggedById      String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sourceWorkOrder WorkOrder @relation(fields: [sourceWoId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  oldData   Json?
  newData   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model ApprovalRequest {
  id                String            @id @default(uuid())
  type              ApprovalType
  relatedEntityId   String
  relatedEntityName String
  requestedById     String
  requestedDate     DateTime          @default(now())
  reason            String
  priority          Priority
  status            ApprovalStatus    @default(PENDING)
  existingValues    Json?
  proposedValues    Json?
  remarks           String?
  attachments       String[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  history           ApprovalHistory[]
  requestedBy       User              @relation("RequestedApprovals", fields: [requestedById], references: [id])
}

model ApprovalHistory {
  id                String          @id @default(uuid())
  approvalRequestId String
  action            String
  actionById        String
  actionDate        DateTime        @default(now())
  comments          String?
  actionBy          User            @relation("ApprovalActions", fields: [actionById], references: [id])
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
}

model Issue {
  id           String     @id @default(uuid())
  type         IssueType
  description  String
  photoUrls    String[]   @default([])
  woId         String?
  reportedById String
  status       String     @default("OPEN")
  priority     Priority   @default(MEDIUM)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  reportedBy   User       @relation("ReportedIssues", fields: [reportedById], references: [id])
  workOrder    WorkOrder? @relation(fields: [woId], references: [id])
}

model LabelPrintJob {
  id            String    @id @default(uuid())
  workOrderId   String
  batchNumber   String
  barcodeType   String
  printedQty    Int
  printedById   String
  status        String    @default("Printed")
  reprintReason String?
  type          PrintJobType @default(INITIAL)
  printer       String       @default("Unknown")
  labelTemplate String       @default("Retail Label")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  User          User      @relation(fields: [printedById], references: [id])
  WorkOrder     WorkOrder @relation(fields: [workOrderId], references: [id])
  labelTasks    LabelApplicationTask[]
}

model LabelApplicationTask {
  id                String    @id @default(uuid())
  woId              String
  workOrder         WorkOrder @relation(fields: [woId], references: [id])
  printJobId        String
  printJob          LabelPrintJob  @relation(fields: [printJobId], references: [id])
  operatorId        String
  operator          User      @relation("AssignedTasks", fields: [operatorId], references: [id])
  assignedById      String
  assignedBy        User      @relation("TasksAssignedBy", fields: [assignedById], references: [id])
  requiredQuantity  Float
  appliedQuantity   Float     @default(0)
  remainingQuantity Float
  status            TaskStatus @default(ASSIGNED)
  assignedAt        DateTime  @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
}

enum ProductType {
  RAW_MATERIAL
  PACKAGING
  FINISHED_GOOD
}

enum WoStatus {
  DRAFT
  PENDING
  APPROVED
  MATERIAL_ISSUED
  PACKING_STARTED
  PACKING_IN_PROGRESS
  PACKING_COMPLETED
  LABEL_APPLICATION_ASSIGNED
  LABEL_APPLICATION_IN_PROGRESS
  LABELS_APPLIED
  QC_PENDING
  QC_PASSED
  COMPLETED
  CANCELLED
}

enum WoPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IssueStatus {
  PENDING
  ISSUED
}

enum QcResult {
  PASS
  PARTIAL_PASS
  REJECT
  REWORK
  DISCARD
}

enum QcSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum ApprovalType {
  WORK_ORDER
  MATERIAL_ISSUE
  PACKING_VARIANCE
  QC_REWORK
  REPACKING
  BARCODE_REPRINT
  FINISHED_GOODS
  WASTAGE_SCRAP
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueType {
  MACHINE_ISSUE
  MATERIAL_SHORTAGE
  BARCODE_PROBLEM
  DAMAGED_PRODUCT
  PACKING_QUALITY_ISSUE
  APP_SYSTEM_ISSUE
  OTHER
}

enum PrintJobType {
  INITIAL
  REPRINT
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  ISSUE_REPORTED
  COMPLETED
}
