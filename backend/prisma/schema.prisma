generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String            @id @default(uuid())
  email              String            @unique
  password           String
  name               String
  roleId             String
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  approvalActions    ApprovalHistory[] @relation("ApprovalActions")
  requestedApprovals ApprovalRequest[] @relation("RequestedApprovals")
  auditLogs          AuditLog[]
  materialIssues     MaterialIssue[]
  qualityChecks      QualityCheck[]
  role               Role              @relation(fields: [roleId], references: [id])
  workOrders         WorkOrder[]
  notifications      Notification[]
  userSetting        UserSetting?
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model UnitOfMeasure {
  id           String    @id @default(uuid())
  name         String    @unique
  abbreviation String    @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
}

model Product {
  id              String          @id @default(uuid())
  sku             String          @unique
  name            String
  categoryId      String
  uomId           String
  type            ProductType
  isActive        Boolean         @default(true)
  availableStock  Float           @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  finishedGoods   FinishedGoods[]
  category        Category        @relation(fields: [categoryId], references: [id])
  uom             UnitOfMeasure   @relation(fields: [uomId], references: [id])
  recipesAsOutput Recipe[]        @relation("RecipeOutput")
  recipeItems     RecipeItem[]
  workOrders      WorkOrder[]
}

model Warehouse {
  id               String            @id @default(uuid())
  name             String            @unique
  location         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  storageLocations StorageLocation[]
}

model StorageLocation {
  id          String    @id @default(uuid())
  name        String
  warehouseId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
}

model Recipe {
  id              String       @id @default(uuid())
  code            String       @unique
  name            String
  outputProductId String
  outputQty       Float
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  outputProduct   Product      @relation("RecipeOutput", fields: [outputProductId], references: [id])
  items           RecipeItem[]
  workOrders      WorkOrder[]
}

model RecipeItem {
  id             String   @id @default(uuid())
  recipeId       String
  inputProductId String
  requiredQty    Float
  tolerancePct   Float    @default(0)
  isPackaging    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  inputProduct   Product  @relation(fields: [inputProductId], references: [id])
  recipe         Recipe   @relation(fields: [recipeId], references: [id])
}

model WorkOrder {
  id             String          @id @default(uuid())
  woNumber       String          @unique
  productId      String
  recipeId       String
  status         WoStatus        @default(DRAFT)
  priority       WoPriority      @default(MEDIUM)
  requiredQty    Float
  actualProduced Float?
  actualRejected Float?
  batchNumber    String?         @unique
  supervisorId   String
  expectedDate   DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  finishedGoods  FinishedGoods[]
  materialIssues MaterialIssue[]
  qualityChecks  QualityCheck[]
  repackingLogs  RepackingLog[]
  product        Product         @relation(fields: [productId], references: [id])
  recipe         Recipe          @relation(fields: [recipeId], references: [id])
  supervisor     User            @relation(fields: [supervisorId], references: [id])
}

model MaterialIssue {
  id         String      @id @default(uuid())
  issueNo    String      @unique
  woId       String
  issuedById String
  status     IssueStatus @default(PENDING)
  payload    Json
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  issuedBy   User        @relation(fields: [issuedById], references: [id])
  workOrder  WorkOrder   @relation(fields: [woId], references: [id])
}

model QualityCheck {
  id            String      @id @default(uuid())
  qcNumber      String      @unique
  woId          String
  inspectorId   String
  checkedQty    Float
  result        QcResult
  severity      QcSeverity?
  failureReason String?
  remarks       String?
  checksPayload Json
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  inspector     User        @relation(fields: [inspectorId], references: [id])
  workOrder     WorkOrder   @relation(fields: [woId], references: [id])
}

model FinishedGoods {
  id          String    @id @default(uuid())
  fgNumber    String    @unique
  woId        String
  productId   String
  batchNumber String
  postedQty   Float
  destination String
  costPayload Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id])
  workOrder   WorkOrder @relation(fields: [woId], references: [id])
}

model RepackingLog {
  id              String    @id @default(uuid())
  rpNumber        String    @unique
  sourceWoId      String
  repackType      String
  recoverableQty  Float
  wasteQty        Float
  newBatchNumber  String?
  targetRecipeId  String?
  loggedById      String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sourceWorkOrder WorkOrder @relation(fields: [sourceWoId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  oldData   Json?
  newData   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model ApprovalRequest {
  id                String            @id @default(uuid())
  type              ApprovalType
  relatedEntityId   String
  relatedEntityName String
  requestedById     String
  requestedDate     DateTime          @default(now())
  reason            String
  priority          Priority
  status            ApprovalStatus    @default(PENDING)
  existingValues    Json?
  proposedValues    Json?
  remarks           String?
  attachments       String[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  history           ApprovalHistory[]
  requestedBy       User              @relation("RequestedApprovals", fields: [requestedById], references: [id])
}

model ApprovalHistory {
  id                String          @id @default(uuid())
  approvalRequestId String
  action            String
  actionById        String
  actionDate        DateTime        @default(now())
  comments          String?
  actionBy          User            @relation("ApprovalActions", fields: [actionById], references: [id])
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
}

enum ProductType {
  RAW_MATERIAL
  PACKAGING
  FINISHED_GOOD
}

enum WoStatus {
  DRAFT
  PENDING
  APPROVED
  MATERIAL_ISSUED
  PACKING_STARTED
  QC_PENDING
  QC_PASSED
  COMPLETED
  CANCELLED
}

enum WoPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IssueStatus {
  PENDING
  ISSUED
}

enum QcResult {
  PASS
  PARTIAL_PASS
  REJECT
  REWORK
  DISCARD
}

enum QcSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum ApprovalType {
  WORK_ORDER
  MATERIAL_ISSUE
  PACKING_VARIANCE
  QC_REWORK
  REPACKING
  BARCODE_REPRINT
  FINISHED_GOODS
  WASTAGE_SCRAP
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSetting {
  id        String   @id @default(uuid())
  userId    String   @unique
  theme     String   @default("light")
  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
